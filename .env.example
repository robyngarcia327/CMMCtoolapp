# App Configuration
PORT=3000
NODE_ENV=development

# --- AWS COGNITO CONFIGURATION ---
# Replace with your Cognito Region (e.g., us-east-1)
VITE_COGNITO_REGION=
# Replace with your Cognito User Pool ID
VITE_COGNITO_USER_POOL_ID=
# Replace with your Cognito Client ID
VITE_COGNITO_CLIENT_ID=

# --- STRIPE CONFIGURATION ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_YEARLY=
STRIPE_WEBHOOK_SECRET=
APP_SUCCESS_URL=
APP_CANCEL_URL=

# --- AWS DYNAMODB CONFIGURATION ---
DYNAMODB_TENANTS_TABLE=Tenants
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY should be set in the environment
