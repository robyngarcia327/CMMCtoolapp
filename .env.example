# App Configuration
PORT=3000
NODE_ENV=development

# --- AZURE AD CONFIGURATION ---
# Replace with your Azure AD Tenant ID (or 'common', 'organizations', 'consumers')
VITE_AZURE_TENANT_ID=
# Replace with your Azure AD Application (client) ID
VITE_AZURE_CLIENT_ID=
# The redirect URI must be registered in the Azure Portal (e.g., https://app.cualleecyber.com)
VITE_AZURE_REDIRECT_URI=
