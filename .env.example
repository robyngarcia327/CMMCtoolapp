# ============================================================
# LOCAL DEVELOPMENT — copy this file to .env and fill in values
# Production values are set in AWS Amplify Console → Environment Variables
# ============================================================

# --- FRONTEND (Vite) ---
# Your API Gateway invoke URL (e.g. https://abc123.execute-api.us-east-1.amazonaws.com/prod)
# The Vite dev server will proxy /api/* → this URL (stripping the /api prefix)
VITE_API_BASE_URL=

# AWS Cognito — get these from the AWS Cognito Console
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=

# --- BACKEND LAMBDA ENV VARS ---
# (Set these in AWS Lambda Console → Configuration → Environment variables)
# (Also set them in AWS Amplify Console if used server-side)

# Stripe — get from Stripe Dashboard → Developers → API Keys / Webhooks
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PRICE_ID_YEARLY=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Redirect URLs after Stripe Checkout (your Amplify app domain)
APP_SUCCESS_URL=https://your-app.amplifyapp.com/?checkout=success&session_id={CHECKOUT_SESSION_ID}
APP_CANCEL_URL=https://your-app.amplifyapp.com/?checkout=cancel

# DynamoDB Table Names
DYNAMODB_TENANTS_TABLE=Tenants
DYNAMODB_USERS_TABLE=Users
ORG_TABLE=OrgDirectory
EVID_TABLE=Evidence

# S3
EVID_BUCKET=general-purpose-evidence-collection
EVID_PREFIX_ROOT=orgs

# Upload / Download settings
UPLOAD_URL_TTL_SECONDS=900
DOWNLOAD_URL_TTL_SECONDS=900
MAX_UPLOAD_BYTES=52428800

# AWS Region
AWS_REGION=us-east-1
